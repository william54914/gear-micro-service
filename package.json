{
  "name": "gearhuboneapi",
  "version": "1.0.0",
  "description": "Express microservice with Sequelize and PostgreSQL",
  "main": "src/index.js",
  "scripts": {
    "start": "node --max-old-space-size=8096 src/index.js",
    "dev": "nodemon --max-old-space-size=8096 src/index.js",
    "migrate": "node src/scripts/runMigration.js",
    "seed:users": "node src/scripts/seedUsers.js",
    "setup:users": "node src/scripts/setupUserTable.js"
  },
  "dependencies": {
    "@api/sp-api": "file:.api/apis/sp-api",
    "@azure/msal-node": "^3.5.0",
    "@sequelize/core": "^7.0.0-alpha.46",
    "@sequelize/postgres": "^7.0.0-alpha.46",
    "axios": "^1.9.0",
    "basic-ftp": "^5.0.5",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "pg": "^8.11.3",
    "ssh2-sftp-client": "^12.0.0",
    "umzug": "^3.8.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.3"
  }
}
