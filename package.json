{
  "name": "gear-microservice",
  "version": "1.0.0",
  "description": "Microservice for managing vendor products and marketplace integrations",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "cross-env NODE_ENV=test jest",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage",
    "test:unit": "cross-env NODE_ENV=test jest --config src/tests/jest.unit.config.js",
    "test:integration": "cross-env NODE_ENV=test jest --config src/tests/jest.integration.config.js",
    "test:e2e": "cross-env NODE_ENV=test jest --config src/tests/jest.e2e.config.js",
    "test:performance": "cross-env NODE_ENV=test jest --config src/tests/jest.performance.config.js",
    "test:k6": "node src/tests/performance/run.js",
    "test:clean": "jest --clearCache",
    "test:all": "node src/scripts/runAllTests.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "seed": "sequelize-cli db:seed:all",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "dependencies": {
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "api": "^6.1.3",
    "aws4": "^1.13.2",
    "basic-ftp": "^5.0.5",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ftp": "^0.3.10",
    "helmet": "^7.1.0",
    "isomorphic-fetch": "^3.0.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "oas": "^20.11.0",
    "pg": "^8.11.3",
    "sequelize": "^6.37.7",
    "ssh2-sftp-client": "^12.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.10",
    "artillery": "^2.0.0-38",
    "cross-env": "^7.0.3",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-jest": "^27.6.0",
    "jest": "^29.7.0",
    "k6": "^0.0.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.1.0",
    "sequelize-mock": "^0.10.2",
    "sqlite3": "^5.1.7",
    "supertest": "^6.3.4",
    "umzug": "^3.8.2"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/src/tests/setup.js"
    ],
    "testMatch": [
      "<rootDir>/src/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/tests/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testTimeout": 10000
  }
}
